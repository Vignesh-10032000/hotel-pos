# BIRYANI POS — ENVIRONMENT VARIABLES TEMPLATE
# For local Windows browser demo, all operations run completely client-side via Dexie / IndexedDB.
# NO external API keys or secrets are required for the initial demo.

# Application Configuration
VITE_APP_NAME="Biryani POS"
VITE_APP_ENV="development"
VITE_DEFAULT_LOCALE="en-IN"
VITE_CURRENCY_SYMBOL="₹"

# POS Terminal Defaults (Demo Mode)
VITE_DEMO_TERMINAL_ID="POS-WIN-01"
VITE_DEMO_STORE_NAME="Royal Biryani House"
VITE_DEMO_GST_RATE_PERCENT="5"
VITE_MOCK_PAYMENT_LATENCY_MS="800"

# Future Integration Placeholders (Leave unset for local demo)
# VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_ENABLE_SERVER_SYNC=false
